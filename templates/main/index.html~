{% extends 'layout/basic.html' %}

{% load thumbnail %}
{% load static %}
{% load django_bootstrap5 %}

{% block content %}
    <h2>Последние 10 объявлений</h2>
    {% if bbs %}
        <div class="vstack gap-3 my-4">
        {% for bb in bbs %}
            <div class="card">
                {% url 'main:bb_detail' rubric_pk=rubric.pk pk=bb.pk as url %}
                <div class="row p-3">
                    <a href="{{ url }}{{ all }}" class="col-md-2">
                        {% if bb.image %}
                            <img class="img-fluid"
                                 src="{% thumbnail bb.image 'default' %}">
                        {% else %}
                            <img src="{% static 'main/empty.jpg' %}"
                                 class="img-fluid">
                        {% endif %}
                    </a>

                    <div class="col-md-10 card-body">
                        <h3 class="card-title">
                            <a href="{{ url }}{{ all }}">{{ bb.title }}</a>
                        </h3>
                        <div class="card-text mb-2">{{ bb.content }}</div>
                        <p class="card-text fw-bold">{{ bb.price }} тг.</p>
                        <p class="card-text rext-end fst-italic">
                            {{ bb.created_at }}
                        </p>
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    {% endif %}
{% endblock %}