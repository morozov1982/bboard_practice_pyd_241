{% extends 'layout/basic.html' %}

{% load django_bootstrap5 %}

{% block title %}{{ bb.title }} - {{ bb.rubric.name }}{% endblock %}

{% block content %}
    <div class="row mt-3">
    {% if bb.image %}
        <div class="col-md-auto">
            <img src="{{ bb.image.url }}" alt="{{ bb.title }} - {{ bb.rubric.name }}"
                 class="main-image">
        </div>
    {% endif %}
    <div class="col">
        <h2>{{ bb.title }}</h2>
        <p>{{ bb.content }}</p>
        <p class="fw-bold">{{ bb.price }} тг.</p>
        <p>{{ bb.contacts }}</p>
        <p class="text-end fst">Добавлено {{ bb.created_at }}</p>
    </div>
    </div>
{% if ais %}
    <div class="d-flex justify-content-between flex-wrap mt-5">
        {% for ai in ais %}
            <div class="d-flex justify-content-center align-items-center">
                <img src="{{ ai.image.url }}" class="additional-image">
            </div>
        {% endfor %}
    </div>
{% endif %}
    <p><a href="{% url 'main:rubric_bbs' pk=bb.rubric.pk %}{{ all }}">
            Назад</a></p>


    <h4 class="mt-5">Новый комментарий</h4>
    <form method="post">
        {% csrf_token %}
        {% bootstrap_form form layout='horizontal' %}
        {% bootstrap_button 'Добавить' %}
    </form>

    

{% endblock %}