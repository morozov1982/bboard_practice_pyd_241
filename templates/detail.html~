{% extends 'layout/base.html' %}

{% load static %}

{% block title %}{{ bb.title }}{% endblock %}

{% block css %}
    <link rel="stylesheet" href="{%  static 'assets/css/flex-slider.css' %}">
{% endblock %}

{% block content %}
    <!-- Page Content -->
    <!-- Single Starts Here -->
    <div class="single-product">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="section-heading">
              <div class="line-dec"></div>
              <h1>{{ bb.title }}</h1>
            </div>
          </div>
          <div class="col-md-6">
            <div class="product-slider">
              <div id="slider" class="flexslider">
                <ul class="slides">

                    <li>
                        <img src="{{ bb.image.url }}" alt="{{ bb.title }}">
                    </li>

                    {% for ai in ais %}
                    <li>
                        <img src="{{ ai.image.url }}" alt="{{ bb.title }}">
                    </li>
                    {% endfor %}

                  <!-- items mirrored twice, total of 12 -->
                </ul>
              </div>
              <div id="carousel" class="flexslider">
                <ul class="slides">
                    <li>
                        <img src="{{ bb.image.url }}" alt="{{ bb.title }}">
                    </li>

                    {% for ai in ais %}
                    <li>
                        <img src="{{ ai.image.url }}" alt="{{ bb.title }}">
                    </li>
                    {% endfor %}
                
                  <!-- items mirrored twice, total of 12 -->
                </ul>
              </div>
            </div>
          </div>

            <div class="col-md-6">
            <div class="right-content">
              <h4>Детали: {{ bb.title }}</h4>
              <h6>{{ bb.price }} тг.</h6>
              <p>{{ bb.content }}</p>
              <div class="down-content">
                <div class="categories">
                  <h6>Category: <span><a href="#">{{ bb.rubric.name }}</a></span></h6>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
    <!-- Single Page Ends Here -->

{% if same_bbs %}
    <!-- Similar Starts Here -->
    <div class="featured-items">
      <div class="container">
        <div class="row">
          <div class="col-md-12">
            <div class="section-heading">
              <div class="line-dec"></div>
              <h1>Похожие товары</h1>
            </div>
          </div>
          <div class="col-md-12">
            <div class="owl-carousel owl-theme">

                {% for bb in same_bbs %}
                    <a href="{% url 'main:bb_detail' rubric_pk=bb.rubric.pk pk=bb.pk %}">
                        <div class="featured-item">
                            <img src="{{ bb.image.url }}" alt="{{ bb.title }}">
                            <h4>{{ bb.title }}</h4>
                            <h6>{{ bb.price }} тг.</h6>
                        </div>
                    </a>
                {% endfor %}

            </div>
          </div>
        </div>
      </div>
    </div>
    <!-- Similar Ends Here -->
{% endif %}

{% endblock %}

{% block js %}
    <script src="{% static 'assets/js/isotope.js' %}"></script>
    <script src="{% static 'assets/js/flex-slider.js' %}"></script>
{% endblock %}